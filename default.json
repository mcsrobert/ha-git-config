{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Update the versions pinned in a Home Assistant configuration repository",
  "customManagers": [
    {
      "description": "Update release assets in hacs.yaml",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)hacs\\.ya?ml$/"],
      "matchStrings": ["repository: (?<depName>\\S+)\\n\\s+version: (?<currentValue>\\S+)\\n\\s+asset: "],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^[vV]?(?<major>\\d+)(?:\\.(?<minor>\\d+))?(?:\\.(?<patch>\\d+))?(?<prerelease>[-.]?[a-zA-Z].*)?$"
    },
    {
      "description": "Update commits in hacs.yaml",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)hacs\\.ya?ml$/"],
      "matchStrings": ["repository: (?<depName>\\S+)\\n\\s+version: (?<currentValue>\\S+)\\n\\s+commit: (?<currentDigest>[0-9a-f]{40})"],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "regex:^[vV]?(?<major>\\d+)(?:\\.(?<minor>\\d+))?(?:\\.(?<patch>\\d+))?(?<prerelease>[-.]?[a-zA-Z].*)?$"
    },
    {
      "description": "Update annotated dependencies",
      "customType": "regex",
      "managerFilePatterns": ["/\\.ya?ml$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.*[:=]\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"],
      "versioningTemplate": "semver-coerced"
    }
  ]
}
